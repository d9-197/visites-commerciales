# Copier en .env puis renseigner. Ne jamais committer .env.
DB_PASSWORD=changez-moi
# 32 caractères minimum, aléatoire : openssl rand -base64 48
JWT_SECRET=
APP_PORT=3000
# Données de démonstration (clients fictifs, comptes de test) : pour un essai uniquement, jamais avec de vraies données.
SEED_DEMO=1
SEED_PASSWORD=

# Synthèse par IA (Mistral), facultatif. Sans clé, la fonction est désactivée.
# Les notes de visite sont envoyées à Mistral : voir docs/IA_MISTRAL.md (contrat de sous-traitance, traitement dans l'UE à confirmer).
MISTRAL_API_KEY=
# Modèle (par défaut mistral-small-latest : à vérifier dans la documentation Mistral au moment du déploiement)
MISTRAL_MODEL=mistral-small-latest
# Tarifs en euros par million de jetons, à relever sur la grille de prix de Mistral. Sans tarifs, le coût est enregistré à 0
# et le plafond mensuel (30 €/utilisateur) n'est pas appliqué.
# Transcription vocale (Voxtral) : modèle (l'alias « latest » a changé de cible selon les pages de la documentation : à vérifier) et tarif par minute d'audio.
MISTRAL_TRANSCRIBE_MODEL=voxtral-mini-latest
MISTRAL_PRICE_TRANSCRIBE_EUR_PER_MIN=
MISTRAL_PRICE_IN_EUR_PER_M=
MISTRAL_PRICE_OUT_EUR_PER_M=

# Envoi par e-mail d'une visite (facultatif) : compte rendu validé, actions, notes. Destinataires : l'utilisateur et sa hiérarchie, jamais le client.
# Sans SMTP_HOST et SMTP_FROM, la fonction est désactivée. SMTP_SECURE=true pour le port 465 ; sinon STARTTLS si le serveur le propose.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_RATE_PER_HOUR=20

# Marque blanche (facultatif) : nom de l'entreprise (écran de connexion, titre de la page, signature des e-mails) et logo.
# Logo : déposez le fichier dans le dossier ./brand, puis BRAND_LOGO_FILE=/brand/logo.png (png, jpg, webp ou svg ; 512 Ko au plus ; fond transparent conseillé).
# Lus au démarrage : redémarrez le back après modification. Un logo invalide est ignoré (avertissement dans les logs), le nom s'applique quand même.
BRAND_NAME=
BRAND_LOGO_FILE=

# Application servie sous un sous-chemin de votre domaine, par exemple https://exemple.fr/visit : BASE_PATH=/visit
# (vide si l'application est à la racine du domaine). Fonctionne que votre reverse proxy conserve ou retire le préfixe.
BASE_PATH=
